# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto no Supabase
# (painel do Supabase → Project Settings → API Keys). Veja docs/NUVEM.md.
#
# Sem estas variáveis o app funciona só no aparelho, sem login.
# A chave "publishable" pode ficar no app. NUNCA coloque aqui a "secret key" nem a senha do banco.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
